{
  "name": "otp-auth-assessment",
  "version": "0.0.0",
  "private": false,
  "description": "Full-stack assessment boilerplate: OTP-based login / registration (NestJS + React).",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:frontend": "turbo run dev --filter=frontend",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "fetch-cookie": "^3.2.0",
    "node-fetch": "^3.3.2",
    "turbo": "^2.11.7"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,

    // Type-only access to the backend API contract (apps/backend/src/auth/auth.types.ts).
    "paths": {
      "@backend/*": ["../backend/src/*"]
    }
  },
  "include": ["src"]
}

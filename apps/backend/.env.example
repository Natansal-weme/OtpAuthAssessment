# Copy to `.env` (same folder) and fill in. `.env` is git-ignored.

# Secret for hashing one-time codes (HMAC-SHA256), at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Optional
# PORT=3000
# CLIENT_ORIGIN=http://localhost:5173
# DATABASE_DIR=data
